# External Kimodo checkout; use an absolute path.
# The validated revision is recorded in THIRD_PARTY_NOTICES.md.
KIMODO_SOURCE=/absolute/path/to/kimodo
KIMODO_BASE_IMAGE=kimodo:1.0
KIMODO_MCP_IMAGE=kimodo-sonic-mcp:local

# Set to the CPUs available on your machine. Leave empty to use all CPUs.
# On the validated 112-CPU host, 1-111 avoids SONIC's CPU 0 realtime thread.
KIMODO_CPUSET=
TEXT_ENCODER_GPU=0
TEXT_ENCODER_PORT=9550
KIMODO_MCP_PORT=8000
SONIC_ZMQ_PORT=5556
HF_CACHE_DIR=${HOME}/.cache/huggingface

KIMODO_MCP_HOST=0.0.0.0
KIMODO_MCP_PUBLIC_URL=http://127.0.0.1:8000
# Optional Bearer token, at least 24 characters. Keep real secrets in .env.
KIMODO_MCP_TOKEN=
KIMODO_MODEL=Kimodo-SMPLX-RP-v1
KIMODO_DEVICE=cuda
KIMODO_SOURCE_FPS=30
KIMODO_MAX_DURATION=30
KIMODO_MAX_DENOISING_STEPS=200

# Optional proxy; leave empty when not needed.
HTTP_PROXY=
HTTPS_PROXY=
